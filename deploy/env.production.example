# =====================================================================
# Template .env untuk server produksi (cPanel).
# Cara pakai: salin seluruh isi file ini ke .env di folder nata-api/
# pada server (File Manager > New File > nama ".env"), lalu isi bagian
# bertanda GANTI. Nilai APP_KEY / DOCS_ACCESS_KEY / DEPLOY_TOKEN sudah
# diisi oleh deploy/build-artifact.ps1 (lihat DEPLOY-INFO.txt).
# =====================================================================

APP_NAME="Sistem Informasi Belanja Santri"
APP_ENV=production
APP_DEBUG=false

# Kunci aplikasi (WAJIB unik untuk server; jangan pakai kunci komputer lokal)
APP_KEY=

# URL produksi. Boleh dibiarkan kosong (otomatis ikut domain yang diakses),
# atau diisi eksplisit, contoh: https://app.domainanda.com
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# <- GANTI: dari cPanel > MySQL Database Wizard (prefix otomatis, contoh user_nata)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Kunci rahasia pembuka /docs/api dan /status (?key=... atau header X-Access-Key)
DOCS_ACCESS_KEY=

# Kunci rahasia endpoint deploy (harus sama dengan secret DEPLOY_TOKEN di GitHub)
DEPLOY_TOKEN=
